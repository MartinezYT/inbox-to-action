# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # from console.anthropic.com - leave empty to use the offline rules engine
CLAUDE_MODEL=claude-haiku-5-5 # fast + cheap; try claude-sonnet-5-5 for harder inboxes
GROQ_API_KEY=                 # free, no card: console.groq.com - used when there's no Anthropic key
GEMINI_API_KEY=               # free alternative: aistudio.google.com
LLM_MODEL=                    # optional override for Groq/Gemini (default openai/gpt-oss-120b / gemini-2.5-flash)
TRIAGE_MODE=auto              # auto | anthropic | groq | gemini | rules
API_KEY=change-me-long-random # callers must send this in the X-API-Key header
BUSINESS_NAME=Acme Logistics Lagos
DEMO_MODE=false               # true = public dashboard + /api/try (sample data only!)
DEMO_RATE_PER_MINUTE=8
DATABASE_PATH=data/inbox.db
SLACK_WEBHOOK_URL=            # optional: https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=           # optional
TELEGRAM_CHAT_ID=             # optional
